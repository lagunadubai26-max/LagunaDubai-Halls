rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getUserMapping() {
      return get(/databases/$(database)/documents/user_mappings/$(request.auth.uid)).data;
    }

    function hasMapping() {
      return getUserMapping() != null;
    }

    // mapping الجديد يجب أن يطابق مستند المستخدم الفعلي (لا رفع صلاحيات)
    function mappingMatchesUser() {
      let targetUser = get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data;
      return targetUser != null
        && targetUser.role == request.resource.data.role
        && (targetUser.hallId || null) == (request.resource.data.hallId || null)
        && (targetUser.active || 0) != 0;
    }

    function userRole() {
      return getUserMapping().role;
    }

    function userHall() {
      return getUserMapping().hallId;
    }

    function isSuper() {
      return isAuth() && userRole() == 'SuperAdmin';
    }

    function isManager() {
      return isAuth() && userRole() == 'HallManager';
    }

    function isAccountant() {
      return isAuth() && userRole() == 'Accountant';
    }

    function isEmployee() {
      return isAuth() && userRole() == 'Employee';
    }

    function isStaff() {
      return isSuper() || isManager() || isAccountant() || isEmployee();
    }

    function noUsers() {
      return !exists(/databases/$(database)/documents/users/u1);
    }

    // ── Hall-scoped access helpers ──
    function inUserHall(resource) {
      return resource.data.hallId != null && resource.data.hallId == userHall();
    }

    function readHallScoped(resource) {
      return isSuper() || (isStaff() && inUserHall(resource));
    }

    function writeHallScoped(requestRes) {
      return isSuper() || (isStaff() && requestRes.data.hallId != null && requestRes.data.hallId == userHall());
    }

    // ── user_mappings: المستخدم يقرأ/يحدّث mapping نفسه بعد تسجيل الدخول،
    //    مع التحقق من أن الدور يطابق مستند المستخدم (بلا رفع صلاحيات) ──
    match /user_mappings/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create: if (isAuth() && mappingMatchesUser()) || (isAuth() && noUsers());
      allow update: if isAuth() && request.auth.uid == uid && mappingMatchesUser();
      allow delete: if isAuth() && request.auth.uid == uid && userRole() == 'pending';
    }

    // ── users: القراءة لكل مستخدم مصادق (تسجيل الدخول يبحث بالبريد في كل السجلات)،
    //    الكتابة لسوبر أدمن أو مدير قاعته، مع bootstrap لأول مرة ──
    match /users/{docId} {
      allow read: if isAuth();
      allow create: if isSuper() || (isAuth() && noUsers());
      allow update: if isSuper() || (isManager() && resource.data.hallId == userHall());
      allow delete: if isSuper();
    }

    // ── halls: القراءة للجميع المصادقين، تعديل القاعة لمديرها أو سوبر أدمن ──
    match /halls/{hallId} {
      allow read: if isAuth();
      allow create: if isSuper() || (isAuth() && noUsers());
      allow update: if isSuper() || (isManager() && resource.data.id == userHall());
      allow delete: if isSuper();
    }

    // ── settings: شروط العقد والإعدادات — لكل قاعة سجلاتها (hallId) ──
    match /settings/{docId} {
      allow read, update, delete: if isAuth() && (readHallScoped(resource) || noUsers());
      allow create: if isAuth() && (writeHallScoped(request.resource) || noUsers());
    }

    // ── الباقات والإضافات والعملاء والحجوزات والعقود والمدفوعات والمصروفات وسجل التدقيق ──
    match /packages/{docId} {
      allow read, update, delete: if isAuth() && (readHallScoped(resource) || noUsers());
      allow create: if isAuth() && (writeHallScoped(request.resource) || noUsers());
    }

    match /addons/{docId} {
      allow read, update, delete: if isAuth() && (readHallScoped(resource) || noUsers());
      allow create: if isAuth() && (writeHallScoped(request.resource) || noUsers());
    }

    match /clients/{docId} {
      allow read, update, delete: if isAuth() && readHallScoped(resource);
      allow create: if isAuth() && writeHallScoped(request.resource);
    }

    match /bookings/{docId} {
      allow read, update, delete: if isAuth() && readHallScoped(resource);
      allow create: if isAuth() && writeHallScoped(request.resource);
    }

    match /contracts/{docId} {
      allow read, update, delete: if isAuth() && readHallScoped(resource);
      allow create: if isAuth() && writeHallScoped(request.resource);
    }

    match /payments/{docId} {
      allow read, update, delete: if isAuth() && readHallScoped(resource);
      allow create: if isAuth() && writeHallScoped(request.resource);
    }

    match /hall_expenses/{docId} {
      allow read, update, delete: if isAuth() && readHallScoped(resource);
      allow create: if isAuth() && writeHallScoped(request.resource);
    }

    match /audit_logs/{docId} {
      allow read, update, delete: if isAuth() && readHallScoped(resource);
      allow create: if isAuth() && writeHallScoped(request.resource);
    }

    // ── Catch-all: deny anything not explicitly listed ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
